generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ImportSource {
  CSV
  PASTED_URLS
  AUTHORIZED_PROVIDER
}

enum ProfileStatus {
  ACTIVE
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  SKIPPED
}

enum ExecutionStatus {
  DRAFT
  READY
  RUNNING
  PAUSED
  COMPLETE
  FAILED
}

enum ImportRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Profile {
  id          String        @id @default(cuid())
  externalKey String?
  firstName   String?
  lastName    String?
  fullName    String
  headline    String?
  company     String?
  profileUrl  String?       @unique
  email       String?
  notes       String?
  status      ProfileStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  memberships ListProfile[]
  manualTasks ManualTask[]

  @@index([status])
}

model ImportRun {
  id           String          @id @default(cuid())
  source       ImportSource
  provider     String?
  sourceLabel  String?
  status       ImportRunStatus @default(RUNNING)
  totalRows    Int             @default(0)
  acceptedRows Int             @default(0)
  rejectedRows Int             @default(0)
  errorMessage String?
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([source, createdAt])
  @@index([status, createdAt])
}

model ProfileList {
  id          String        @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  memberships ListProfile[]
  workflows   Workflow[]

  @@index([name])
}

model ListProfile {
  id        String      @id @default(cuid())
  listId    String
  profileId String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  list      ProfileList @relation(fields: [listId], references: [id], onDelete: Cascade)
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([listId, profileId])
  @@index([listId, createdAt])
  @@index([profileId])
}

model Workflow {
  id          String              @id @default(cuid())
  name        String
  description String?
  definition  Json
  status      ExecutionStatus     @default(DRAFT)
  listId      String?
  list        ProfileList?        @relation(fields: [listId], references: [id], onDelete: SetNull)
  executions  WorkflowExecution[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model WorkflowExecution {
  id          String          @id @default(cuid())
  workflowId  String
  status      ExecutionStatus @default(READY)
  startedAt   DateTime?
  finishedAt  DateTime?
  workflow    Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  manualTasks ManualTask[]

  @@index([workflowId, status])
}

model ManualTask {
  id           String             @id @default(cuid())
  title        String
  instructions String
  status       TaskStatus         @default(TODO)
  dueAt        DateTime?
  profileId    String?
  executionId  String?
  profile      Profile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  execution    WorkflowExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, dueAt])
}
